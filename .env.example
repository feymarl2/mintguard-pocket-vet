# MintGuard Pocket Vet — environment template.
# Copy to `.env.local` (gitignored, never commit it) and fill in the values
# from the Firebase console (Project settings → Your apps → Web app).
# Production: set the same variables in the hosting provider's dashboard
# (Vercel → Project → Settings → Environment Variables) and redeploy.
# These are public-by-design project identifiers (Firebase AI Logic holds
# the Gemini API key server-side) — still, keep them out of the repo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA Enterprise site key for App Check (Security → App Check → Apps).
VITE_APPCHECK_SITE_KEY=
